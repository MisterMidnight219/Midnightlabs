# Bind externally exposed Observatory services to a deliberate local address.
OBSERVATORY_BIND_ADDRESS=127.0.0.1

# Resolve these IDs on the deployment host; do not assume they are portable.
DOCKER_GROUP_ID=REPLACE_ME
JOURNAL_GROUP_ID=REPLACE_ME

# Store the real password outside version control.
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=REPLACE_ME
